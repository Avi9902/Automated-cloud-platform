# Terraform working files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
!*.tfvars.example
*.auto.tfvars

# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key

# Local tooling
.DS_Store

# Terraform backend configuration with real bucket details
infrastructure/envs/*/backend.hcl
